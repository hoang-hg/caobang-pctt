POSTGRES_USER=pctt
POSTGRES_PASSWORD=pctt_dev_password
POSTGRES_DB=caobang_pctt
POSTGRES_PORT=5433
JWT_SECRET=doi-khoa-bi-mat-nay-khi-trien-khai-that
SIMULATOR=true
# Tắt khi triển khai thật: ẩn danh sách tài khoản demo
DEMO_MODE=true
# Tuỳ chọn: API LLM dạng OpenAI-compatible để bóc tách tin nhắn SOS (để trống = dùng bộ luật offline)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Tích hợp dữ liệu ngoài
# Khoá mã hoá API key đối tác (để trống = dẫn xuất từ JWT_SECRET). Đặt giá trị dài, ngẫu nhiên khi triển khai thật
SECRET_KEY=
# Dự báo tổ hợp ECMWF/GFS từ Open-Meteo (cần Internet; gói miễn phí chỉ cho mục đích phi thương mại)
OPEN_METEO_ENABLED=true
# Broker MQTT cho thiết bị IoT (để trống = tắt)
MQTT_URL=mqtt://mqtt:1883

# Nền tảng chạy thật
# Số tiến trình API (gunicorn). Tiến trình nền (mô phỏng, đồng bộ dữ liệu, MQTT) chạy riêng ở service "worker"
API_WORKERS=2
# Địa chỉ web công khai — dùng trong link email đặt lại mật khẩu và link chia sẻ cảnh báo
PUBLIC_BASE_URL=http://localhost:8080
# Giới hạn tần suất gọi API (Redis). Chỉ tắt khi chạy thử tải
RATE_LIMIT_ENABLED=true
# Kho ảnh phản ánh MinIO — ĐỔI mật khẩu khi triển khai thật
MINIO_ROOT_USER=pctt_minio
MINIO_ROOT_PASSWORD=pctt_minio_dev_password
# Gửi email (mặc định vào Mailpit dev http://localhost:8025). Thật: máy chủ SMTP của tỉnh / dịch vụ email
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
# Tuỳ chọn: Cloudflare Turnstile chống bot cho form phản ánh công khai (để trống = chỉ dùng honeypot + giới hạn tần suất)
TURNSTILE_SECRET=
