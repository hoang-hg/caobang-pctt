POSTGRES_USER=pctt
POSTGRES_PASSWORD=pctt_dev_password
POSTGRES_DB=caobang_pctt
POSTGRES_PORT=5433
JWT_SECRET=doi-khoa-bi-mat-nay-khi-trien-khai-that
SIMULATOR=true
# Tắt khi triển khai thật: ẩn danh sách tài khoản demo
DEMO_MODE=true
# Tuỳ chọn: API LLM dạng OpenAI-compatible để bóc tách tin nhắn SOS (để trống = dùng bộ luật offline)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Tích hợp dữ liệu ngoài
# Khoá mã hoá API key đối tác (để trống = dẫn xuất từ JWT_SECRET). Đặt giá trị dài, ngẫu nhiên khi triển khai thật
SECRET_KEY=
# Dự báo tổ hợp ECMWF/GFS từ Open-Meteo (cần Internet; gói miễn phí chỉ cho mục đích phi thương mại)
OPEN_METEO_ENABLED=true
# Broker MQTT cho thiết bị IoT (để trống = tắt)
MQTT_URL=mqtt://mqtt:1883
